{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci && npm install --prefix NeteaseCloudMusicApi --omit=dev",
  "outputDirectory": "dist",
  "regions": ["hkg1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "NeteaseCloudMusicApi/{module,util,plugins,data}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
